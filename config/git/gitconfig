[alias]
    st = status
    s = switch
    b = branch
    cp = cherry-pick
    co = checkout
    cob = checkout -b 
    ci = commit
    cia = commit --amend
    cian = commit --amend --no-edit
    ps = push
    l = log
    w = whatchanged
    lol = log --oneline
    f = fetch
    rh = reset --hard
    rs = reset --soft
    conflicts = diff --name-only --diff-filter=U
    usm = submodule update --init --recursive --remote
[init]
    defaultBranch = main
[commit]
    gpgsign = false
[push]
